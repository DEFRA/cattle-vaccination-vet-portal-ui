{% extends "layouts/page.njk" %}

{% set pageTitle = t('authentication.failedTitle') %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ t('authentication.failedTitle') }}</h1>
      <p class="govuk-body">{{ t('authentication.failedMessage') }}</p>
      <a class="govuk-link" href="/auth/sign-in">{{ t('authentication.tryAgain') }}</a>
    </div>
  </div>
{% endblock %}