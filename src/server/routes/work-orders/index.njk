{% extends 'layouts/page.njk' %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div data-testid="work-orders">
        {% for workOrder in workOrders %}
          {{ govukSummaryList({
            card: {
              classes: "govuk-!-margin-bottom-4",
              title: {
                text: workOrder.title
              },
              actions: {
                items: [
                  {
                    href: "/work-orders/" + workOrder.id | urlencode,
                    text: t("pages.workOrders.continueWork")
                  },
                  {
                    href: "#",
                    text: t("pages.workOrders.cphDetails")
                  }
                ]
              }
            },
            rows: [
              {
                key: {
                  text: t("pages.workOrders.address")
                },
                value: {
                  text: workOrder.address
                }
              }
            ]
          }) }}
        {% else %}
          <p class="govuk-body">{{ t("pages.workOrders.empty") }}</p>
        {% endfor %}
      </div>
    </div>
  </div>
{% endblock %}
