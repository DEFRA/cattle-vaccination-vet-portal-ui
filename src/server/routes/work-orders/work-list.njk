{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block beforeContent %}
  {{ govukBackLink({
    text: t("pages.workList.back"),
    href: "/work-orders/" + workOrderId | urlencode
  }) }}
{% endblock %}

{% block content %}
  <h1 class="govuk-heading-l">{{ heading }}</h1>

  {{ govukTable({
    firstCellIsHeader: true,
    head: [
      { text: t("pages.workList.earTag") },
      { text: t("pages.workList.dob") },
      { text: t("pages.workList.sex") },
      { text: t("pages.workList.breed") }
    ],
    rows: rows
  }) }}
{% endblock %}
