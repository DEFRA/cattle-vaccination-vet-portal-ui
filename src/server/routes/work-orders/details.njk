{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block beforeContent %}
  {{ govukBackLink({
    text: t("pages.workOrder.back"),
    href: "/work-orders"
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <h2 class="govuk-heading-m">{{ t("pages.workOrder.cphInformation") }}</h2>
      <p class="govuk-body govuk-!-margin-bottom-2">
        {% if cphCode %}
          {{ t("pages.workOrder.cphNumber") }}: {{ cphCode }}<br>
        {% endif %}
        {% if address %}
          {{ t("pages.workOrder.address") }}: {{ address }}
        {% endif %}
      </p>
      <p class="govuk-body govuk-!-margin-bottom-7">
        <a class="govuk-link" href="#">{{ t("pages.workOrder.fullCphInformation") }}</a>
      </p>

      <h2 class="govuk-heading-m" id="vaccination-lists">{{ t("pages.workOrder.vaccinationLists") }}</h2>
      <p class="govuk-body">{{ t("pages.workOrder.vaccinationListsHint") }}</p>
      {{ govukButton({
        text: t("pages.workOrder.createVaccinationList"),
        type: "button"
      }) }}
    </div>
  </div>
{% endblock %}
