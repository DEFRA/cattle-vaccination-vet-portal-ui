NODE_ENV=development
PORT=3000
BACKEND_BASE_URL=http://127.0.0.1:3002

# Single-tenant Entra app registration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URL=http://localhost:3000/auth/sign-in-oidc

# Generate separate random values of at least 32 characters for both passwords.
# For example: openssl rand -base64 48
ENTRA_COOKIE_PASSWORD=
SESSION_COOKIE_PASSWORD=

# Local HTTP only. Use true when serving over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_CACHE_ENGINE=memory